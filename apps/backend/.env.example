# Copy to apps/backend/.env for local Nest/Prisma CLI.
# Docker Compose reads the repo-root .env instead (see /.env.example).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eshop_aggregator?schema=public
JWT_ACCESS_SECRET=<generate via: openssl rand -base64 48>
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
