{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/../libs/common/src/$1",
    "^@app/(.*)$": "<rootDir>/../src/$1",
    "^@eshop/shared$": "<rootDir>/../../../packages/shared/src"
  }
}