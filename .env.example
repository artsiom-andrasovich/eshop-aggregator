NODE_ENV=development
PORT=3000

# Local CLI / Nest (host -> compose Postgres on 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eshop_aggregator?schema=public

JWT_ACCESS_SECRET=<generate via: openssl rand -base64 48>
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
